local function CreateSlider(name,min,max,default,order,cb) local f=Instance.new("Frame") f.Parent=Scroll f.BackgroundColor3=Color3.fromRGB(24,24,34) f.Size=UDim2.new(1,0,0,48) f.LayoutOrder=order Corner(f,10) local l=Instance.new("TextLabel") l.Parent=f l.BackgroundTransparency=1 l.Position=UDim2.new(0,12,0,4) l.Size=UDim2.new(1,-24,0,16) l.Font=getgenv().FONT2 l.Text=name..": "..default l.TextColor3=Color3.fromRGB(180,180,190) l.TextSize=9 l.TextXAlignment=Enum.TextXAlignment.Left local bg=Instance.new("TextButton") bg.Parent=f bg.BackgroundColor3=Color3.fromRGB(35,35,50) bg.Position=UDim2.new(0,12,0,26) bg.Size=UDim2.new(1,-24,0,8) bg.Text="" Corner(bg,4) local fill=Instance.new("Frame") fill.Parent=bg fill.BackgroundColor3=Color3.fromRGB(0,180,255) fill.Size=UDim2.new((default-min)/(max-min),0,1,0) Corner(fill,4) local function upd(x) local p=math.clamp((x-bg.AbsolutePosition.X)/bg.AbsoluteSize.X,0,1) fill.Size=UDim2.new(p,0,1,0) local v=math.floor(min+p*(max-min)) l.Text=name..": "..v cb(v) end local drag=false bg.MouseButton1Down:Connect(function() drag=true end) UIS.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=false end end) UIS.InputChanged:Connect(function(i) if drag then upd(i.Position.X) end end) bg.InputBegan:Connect(function(i) upd(i.Position.X) end) return f end
local function setState(b,on) local s=b:FindFirstChild("State",true) if on then b.BackgroundColor3=Color3.fromRGB(0,90,200) s.Text="ON" s.BackgroundColor3=Color3.fromRGB(0,200,255) s.TextColor3=Color3.new(1,1,1) else b.BackgroundColor3=Color3.fromRGB(24,24,34) s.Text="OFF" s.BackgroundColor3=Color3.fromRGB(40,40,55) end end
