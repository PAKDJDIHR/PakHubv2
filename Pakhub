local EspCache={} local function CreateEsp(plr) if plr==lp then return end local box,line pcall(function() box=Drawing.new("Square") box.Visible=false box.Color=Color3.fromRGB(0,200,255) line=Drawing.new("Line") line.Visible=false line.Color=Color3.fromRGB(0,200,255) end) local bill=Instance.new("BillboardGui") bill.Parent=guiParent bill.AlwaysOnTop=true bill.Size=UDim2.new(0,200,0,30) bill.StudsOffset=Vector3.new(0,3,0) local txt=Instance.new("TextLabel") txt.Parent=bill txt.BackgroundTransparency=1 txt.Size=UDim2.new(1,0,1,0) txt.Font=Enum.Font.GothamBold txt.TextSize=11 txt.TextStrokeTransparency=0.5 txt.TextColor3=Color3.new(1,1,1) EspCache[plr]={box=box,line=line,bill=bill,label=txt} end
RS.RenderStepped:Connect(function() if FOVCircle then FOVCircle.Visible=AimbotOn FOVCircle.Position=Vector2.new(workspace.CurrentCamera.ViewportSize.X/2,workspace.CurrentCamera.ViewportSize.Y/2) FOVCircle.Radius=FOV end if AimbotOn and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then local closest,dist=nil,FOV for _,v in pairs(Players:GetPlayers()) do if v~=lp and v.Character and v.Character:FindFirstChild("Head") then local pos,on=workspace.CurrentCamera:WorldToViewportPoint(v.Character.Head.Position) if on then local mag=(Vector2.new(pos.X,pos.Y)-Vector2.new(workspace.CurrentCamera.ViewportSize.X/2,workspace.CurrentCamera.ViewportSize.Y/2)).Magnitude if mag<dist then dist=mag closest=v end end end end if closest then workspace.CurrentCamera.CFrame=workspace.CurrentCamera.CFrame:Lerp(CFrame.new(workspace.CurrentCamera.CFrame.Position,closest.Character.Head.Position),0.15) end end for plr,data in pairs(EspCache) do if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then local hrp=plr.Character.HumanoidRootPart local pos,on=workspace.CurrentCamera:WorldToViewportPoint(hrp.Position) if on then if data.box then data.box.Visible=BoxOn if BoxOn then local s=2000/pos.Z data.box.Size=Vector2.new(s,s*1.4) data.box.Position=Vector2.new(pos.X-s/2,pos.Y-s*1.4/2) end end if data.line then data.line.Visible=LineOn if LineOn then data.line.From=Vector2.new(workspace.CurrentCamera.ViewportSize.X/2,workspace.CurrentCamera.ViewportSize.Y) data.line.To=Vector2.new(pos.X,pos.Y) end end data.bill.Adornee=hrp local t="" if NameOn then t=t..plr.DisplayName.." " end if DistOn then t=t.."["..math.floor((lp.Character.HumanoidRootPart.Position-hrp.Position).Magnitude).."m] " end if HealthOn then t=t.."("..math.floor(plr.Character.Humanoid.Health).."HP)" end data.label.Text=t data.label.Visible=(NameOn or DistOn or HealthOn) else if data.box then data.box.Visible=false end if data.line then data.line.Visible=false end data.label.Visible=false end end end end)
RS.Stepped:Connect(function() if NoclipOn and lp.Character then for _,v in pairs(lp.Character:GetDescendants()) do if v:IsA("BasePart") then v.CanCollide=false end end end end)
RS.Heartbeat:Connect(function() if SpinOn and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then lp.Character.HumanoidRootPart.CFrame=lp.Character.HumanoidRootPart.CFrame*CFrame.Angles(0,math.rad(SpinSpeed),0) end end)
